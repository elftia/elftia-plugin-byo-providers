{
  "name": "byo-providers",
  "version": "0.4.1",
  "kind": "app-extension",
  "permissions": [
    "host:llm-config",
    "host:media-config",
    "host:search-config",
    "host:object-storage-config",
    "host:subscription-auth",
    "host:agent-config",
    "host:cli-runtime",
    "host:secrets-pack",
    "host:external-links"
  ],
  "displayName": "BYO Providers",
  "description": "First-party BYO credential-entry plugin. Credentials travel inward through dedicated masked host services; provider/account/CLI reads expose status and masked metadata only.",
  "contributes": {
    "renderer": {
      "entry": "index.mjs",
      "execution": "opaque-frame-v1",
      "requiredMajor": 2,
      "requiredMinor": 0,
      "builtAgainst": "2.0.0"
    },
    "main": {
      "entry": "index.cjs",
      "requiredMajor": 2,
      "requiredMinor": 0,
      "builtAgainst": "2.0.0"
    }
  },
  "minElftiaVersion": "0.2.8"
}
