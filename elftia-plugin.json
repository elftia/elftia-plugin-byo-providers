{
  "name": "byo-providers",
  "version": "0.2.10",
  "kind": "app-extension",
  "permissions": [
    "host:llm-config",
    "host:media-config",
    "host:search-config",
    "host:object-storage-config",
    "host:subscription-auth",
    "host:agent-config",
    "host:cli-runtime",
    "host:secrets-pack"
  ],
  "displayName": "BYO Providers",
  "description": "First-party BYO credential-entry plugin. Credentials travel inward through dedicated masked host services; provider/account/CLI reads expose status and masked metadata only.",
  "contributes": {
    "renderer": {
      "entry": "index.mjs",
      "requiredMajor": 1,
      "requiredMinor": 20,
      "builtAgainst": "1.49.0"
    },
    "main": {
      "entry": "index.cjs",
      "requiredMajor": 1,
      "requiredMinor": 49,
      "builtAgainst": "1.49.0"
    }
  }
}
